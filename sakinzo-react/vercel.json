{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sitemap-live.xml",
      "destination": "/api/page?kind=sitemap"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/page?kind=blog&value=:slug"
    },
    {
      "source": "/projects/:id",
      "destination": "/api/page?kind=project&value=:id"
    },
    {
      "source": "/blog",
      "destination": "/api/page?kind=blog-index"
    },
    {
      "source": "/projects",
      "destination": "/api/page?kind=project-index"
    },
    {
      "source": "/admin/:path*",
      "destination": "/seo/admin.html"
    },
    {
      "source": "/ai-agent-development",
